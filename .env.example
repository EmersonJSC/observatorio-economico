# =============================================================================
# Observatório Econômico — variáveis de ambiente
#
# Copie para `.env` e preencha:
#     cp .env.example .env
#
# `.env` está no .gitignore e NUNCA deve ser commitado.
# O shell tem precedência sobre este arquivo.
# =============================================================================

# -----------------------------------------------------------------------------
# Câmara dos Deputados — Dados Abertos v2
# https://dadosabertos.camara.leg.br/swagger/api.html
#
# NÃO exige chave. As variáveis abaixo só ajustam o recorte da ingestão.
# -----------------------------------------------------------------------------

# Ano das despesas da cota parlamentar a ingerir (separados por vírgula).
CAMARA_ANO_DESPESA=2024

# Legislatura a considerar. 57 = 2023-2027. Vazio = deputados em exercício hoje.
CAMARA_ID_LEGISLATURA=57

# Limite de itens por página (máximo aceito pela API: 100).
CAMARA_ITENS_POR_PAGINA=100

# -----------------------------------------------------------------------------
# Portal da Transparência — API de Dados
# https://portaldatransparencia.gov.br/api-de-dados
#
# CHAVE OBRIGATÓRIA. Cadastre-se em:
#   https://api.portaldatransparencia.gov.br/api-de-dados/cadastrar-email
# A chave é enviada no header `chave-api-dados`.
# Sem ela, esta fonte é ignorada e os dados locais são preservados.
# -----------------------------------------------------------------------------

PORTAL_API_KEY=

# Ano das despesas por órgão e das emendas parlamentares.
PORTAL_ANO=2024

# Mês de referência (MM/AAAA) dos programas sociais por município.
# Ex.: 08/2024 para o Bolsa Família, 06/2020 para a série histórica.
PORTAL_MES_ANO=08/2024

# Programa social ingerido por município. Valores aceitos:
#   bolsa-familia | novo-bolsa-familia | auxilio-brasil | auxilio-emergencial
#                 | bpc | peti | safra | seguro-defeso
PORTAL_PROGRAMA_SOCIAL=bolsa-familia

# Limite de municípios a consultar (0 = todos os 5.570).
# Útil para testar: cada município é uma requisição, e a API tem rate limit.
PORTAL_LIMITE_MUNICIPIOS=0

# -----------------------------------------------------------------------------
# Fallbacks opcionais (já existentes no projeto)
# -----------------------------------------------------------------------------

# Brasil.io — usado quando o TSE bloqueia o download automático.
# Token gratuito em https://brasil.io/auth/tokens-api/
BRASILIO_TOKEN=

# Base dos Dados (datalake no BigQuery) — alternativa ao IBGE SIDRA.
# Requer projeto no Google Cloud com a BigQuery API habilitada.
BD_BILLING_PROJECT=
BD_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Parâmetros de ingestão já existentes
# -----------------------------------------------------------------------------

# IBGE SIDRA
ANO_POPULACAO=2024
ANO_PIB=2021

# TSE
ELECTION_YEAR=2024

# Build do site (subpasta de publicação, ex.: /observatorio-economico/)
VITE_BASE=/
