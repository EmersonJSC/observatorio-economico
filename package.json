{
  "name": "observatorio-economico",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "npm run build:api && npm run build:site",
    "build:api": "npm --prefix apps/api run build",
    "build:web": "npm --prefix apps/web run build",
    "build:site": "npx tsx scripts/build-site.ts",
    "gerar:derivados": "npx tsx scripts/gerar-derivados.ts",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "preview:site": "npm --prefix apps/web run preview",
    "validar:dados": "npx tsx scripts/validar-dados.ts",
    "test:adapters": "npx tsx scripts/test-adapters.ts",
    "ingest": "npx tsx scripts/ingest-all.ts",
    "ingest:indicators": "npx tsx scripts/update-indicators-data.ts",
    "ingest:centroides": "npx tsx scripts/update-centroides.ts",
    "ingest:budget": "npx tsx scripts/update-budget-data.ts",
    "ingest:elections": "npx tsx scripts/update-elections-data.ts",
    "ingest:mandatos": "npx tsx scripts/update-mandatos-gerais.ts",
    "ingest:congresso": "npx tsx scripts/update-congresso-data.ts",
    "ingest:transparencia": "npx tsx scripts/update-transparencia-data.ts",
    "scrape:tse": "npx tsx scripts/scrape-tse.ts",
    "orquestrar": "npx tsx scripts/orquestrador/index.ts",
    "coletar": "npx tsx scripts/orquestrador/index.ts",
    "organizar": "npx tsx scripts/organizacao/index.ts",
    "relacionar": "npx tsx scripts/relacionamentos/index.ts",
    "calcular": "npx tsx scripts/calculos/index.ts",
    "publicar": "npx tsx scripts/publicacao/index.ts",
    "validar:publicacao": "npx tsx scripts/publicacao/validar-cli.ts",
    "test:coletor": "npx tsx --test scripts/coletor/coletor.test.ts",
    "test:raw": "npx tsx --test scripts/raw/raw.test.ts",
    "test:organizacao": "npx tsx --test scripts/organizacao/organizacao.test.ts scripts/organizacao/leitura-avancada.test.ts scripts/organizacao/sidra.test.ts scripts/organizacao/siconfi-malhas.test.ts",
    "test:relacionamentos": "npx tsx --test scripts/relacionamentos/relacionamentos.test.ts",
    "test:calculos": "npx tsx --test scripts/calculos/motores.test.ts scripts/calculos/agregacoes.test.ts",
    "test:publicacao": "npx tsx --test scripts/publicacao/publicacao.test.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/geo-layers": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/react": "^9.4.0",
    "deck.gl": "^9.4.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13"
  }
}
